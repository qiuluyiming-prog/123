{
  "manifest_version": 3,
  "name": "Minimal Icon Extension",
  "version": "1.0.0",
  "description": "An extension that only displays an icon.",
  "action": {
    "default_title": "Minimal Icon Extension",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
